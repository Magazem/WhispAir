# Memoire Environment Configuration
# Copy to /etc/memoire/.env on the server and fill in values
# DO NOT commit this file to git

# Telegram Bot Token (from @BotFather)
TG_BOT_TOKEN=

# Telegram Bot API server (self-hosted, see README)
TG_BOT_API_URL=http://localhost:8081

# Ollama host (local LLM server)
OLLAMA_HOST=http://localhost:11434

# Whisper.cpp CLI path
WHISPER_PATH=/usr/local/bin/whisper-cli

# Claude API key (optional escape hatch)
CLAUDE_API_KEY=

# Server configuration
MEMOIRE_SERVER_HOST=0.0.0.0
MEMOIRE_SERVER_PORT=8080

# Data directory
MEMOIRE_DATA_DIR=/home/memoire/memoire-data

# Logging: debug, info, warn, error
MEMOIRE_LOG_LEVEL=info
